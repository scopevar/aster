{
  "name": "aster",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/scopevar/aster",
  "type": "module",
  "main": "dist/desktop/entry.cjs",
  "engines": {
    "node": ">=22.23.1",
    "pnpm": ">=12.3.4"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "node scripts/build.mjs",
    "daemon": "node node_modules/@aster/cli/dist/cli/main.js",
    "build:cli": "node scripts/build-cli.mjs",
    "pack:cli": "pnpm --filter @aster/cli pack --pack-destination .runtime/cli-pack",
    "dev": "node scripts/dev.mjs",
    "release": "tsx scripts/release.ts",
    "desktop:shortcut": "node scripts/create-desktop-shortcut.mjs",
    "model:auth": "tsx scripts/model-auth.ts",
    "worker": "node dist/worker/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint src packages/cli/src tests scripts electron.vite.config.ts",
    "format": "prettier --write src packages/cli/src packages/cli/package.json tests scripts playwright.config.ts electron.vite.config.ts package.json tsconfig.json eslint.config.js README.md AGENTS.md tests/AGENTS.md",
    "format:check": "prettier --check src packages/cli/src packages/cli/package.json tests scripts playwright.config.ts electron.vite.config.ts package.json tsconfig.json eslint.config.js README.md AGENTS.md tests/AGENTS.md",
    "test": "node scripts/build.mjs && node scripts/test.mjs core && node scripts/test.mjs guards",
    "test:all": "node scripts/build.mjs && node scripts/test.mjs all",
    "test:environment": "node scripts/build.mjs && node scripts/test.mjs environment",
    "test:media": "node scripts/build.mjs && node scripts/test.mjs media",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:renderer": "playwright test --project=renderer",
    "test:e2e:smoke": "playwright test tests/e2e/app-startup.spec.ts tests/e2e/connection-credentials.spec.ts tests/e2e/start-conversation.spec.ts tests/e2e/backup.spec.ts tests/e2e/diagnostics.spec.ts tests/e2e/diagram-export.spec.ts --project=desktop",
    "check:dependencies": "pnpm audit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:architecture && pnpm run check:file-size && pnpm run check:agents && pnpm run test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:agents": "node scripts/check-agents-md.mjs",
    "test:guards": "node --import tsx --test tests/guards.test.ts"
  },
  "dependencies": {
    "@aster/cli": "workspace:*",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/server": "2.3.0",
    "@napi-rs/canvas": "1.0.9",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "cron-parser": "5.10.1",
    "electron-updater": "6.8.9",
    "emojibase-data": "17.0.0",
    "image-size": "2.0.4",
    "ipaddr.js": "2.5.0",
    "katex": "0.18.9",
    "lucide-react": "1.61.0",
    "mammoth": "1.12.3",
    "mdast-util-from-markdown": "2.0.3",
    "mermaid": "11.17.2",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.3.289",
    "proxy-chain": "3.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0",
    "typebox": "1.3.27",
    "unified": "11.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.8.3",
    "yauzl": "3.4.0",
    "zod": "4.6.6",
    "microsandbox": "0.7.11"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "5.2.0",
    "builder-util-runtime": "9.7.0",
    "electron": "44.10.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "micromark-util-types": "2.0.2",
    "postcss": "8.5.31",
    "prettier": "3.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.7"
  }
}
